DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
PORT=4310
HOST=127.0.0.1

# 案件生成流水线（scripts/）用，二选一或都配：
# Kimi K3（默认优先；OpenAI 兼容，长文叙事强）
KIMI_API_KEY=sk-your-kimi-key-here
KIMI_MODEL=kimi-k3
KIMI_BASE_URL=https://api.moonshot.cn/v1
# Qwen（DashScope compatible-mode；Kimi 不可用时自动降级）
# LLM_ENGINE=auto          # auto | kimi | qwen，默认 auto
# QWEN_MODEL=qwen-max
# QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 可选：阿里云百炼（DashScope）API Key，用于多音色 TTS（Sambert）。
# 不配置时，前端回退到浏览器 speechSynthesis（单音色）。
DASHSCOPE_API_KEY=sk-your-dashscope-key-here

# 免费音色源：微软 Edge TTS（322+ 音色，无需 API Key）。默认开启；
# 没有 DASHSCOPE_API_KEY 时会自动作为多音色主源，再不行才回退浏览器语音。
EDGE_TTS_ENABLED=1

# Cloudflare R2 对象存储（可选）。R2_IMAGES_ENABLED=1 时：
#   出图上传 R2（comfyui/generate.mjs）+ /characters/* 从 R2 提供，缺失回退本地（server.js）
R2_IMAGES_ENABLED=0
ACCOUNT_ID=                      # 也接受 R2_ACCOUNT_ID / CLOUDFLARE_ACCOUNT_ID
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
BUCKET_NAME=whodunit             # 也接受 R2_BUCKET_NAME，或从 S3_API 解析
# R2_ENDPOINT=                   # 可选覆盖，默认 https://<ACCOUNT_ID>.r2.cloudflarestorage.com
